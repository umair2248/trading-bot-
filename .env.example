ATR_MIN_MULTIPLIER=0.5
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
EMA_RETRACE_TOLERANCE_PCT=0.15
STRATEGY_NAME=EMA_RSI_MACD
MAGIC_NUMBER=20260717
SL_ATR_MULTIPLIER=1.5
TP_RR_RATIO=2.0
MIN_RR_RATIO=2.0

# Risk Management
RISK_PER_TRADE_PCT=1.0
MAX_OPEN_TRADES=2
MAX_DAILY_LOSS_PCT=2.0
MAX_WEEKLY_LOSS_PCT=5.0
MAX_ACCOUNT_DRAWDOWN_PCT=10.0
